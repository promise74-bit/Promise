NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# WoodPay VTU (airtime, data, cable TV, electricity) — keep the key server-side; never use NEXT_PUBLIC_.
# Generate your key in the WoodPay app: Services → Vendor & API.
WOODPAY_API_KEY=your_woodpay_api_key
# Optional; defaults to https://woodpay.com.ng/api/v1
WOODPAY_BASE_URL=https://woodpay.com.ng/api/v1
# Optional: direct vendor function (default shown). Requests use ?action=<name>.
# WOODPAY_ENDPOINT_URL=https://woodpay.com.ng/.netlify/functions/vendor-api

# Brevo transactional email (welcome, password reset, order emails). Server-side only.
BREVO_API_KEY=your_brevo_api_key
# Optional; must be a verified sender in Brevo
BREVO_SENDER_EMAIL=you@yourdomain.com
BREVO_SENDER_NAME=Promise Computer Research
# Optional; used in email links. Defaults to the request's origin.
# NEXT_PUBLIC_SITE_URL=https://promisecomputerresearch.com.ng
